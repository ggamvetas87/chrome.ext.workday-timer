{
  "manifest_version": 3,
  "name": "Workday Time Calculator",
  "version": "2.0.0",
  "description": "Calculates your clock-out time and reminds you 30 and 10 minutes beforehand",
  "permissions": [
    "alarms",
    "notifications",
    "offscreen",
    "storage",
    "windows"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Workday Time Calculator"
  },
  "background": {
    "service_worker": "src/background/background.js"
  }
}
